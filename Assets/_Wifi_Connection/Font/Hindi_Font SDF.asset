  m_CreationSettings:
    sourceFontFileName: 
    sourceFontFileGUID: d94a87662e9a79d43b892f014e5ac3ea
    faceIndex: 0
    pointSizeSamplingMode: 1
    pointSize: 76
    padding: 10
    paddingMode: 0
    packingMode: 4
    atlasWidth: 1024
    atlasHeight: 1024
    characterSetSelectionMode: 7
    characterSequence: "\u091A\u0930\u0923 1\r\n                \u092E\u094B\u092C\u093E\u0907\u0932
      \u092A\u0930 nexbox \u0915\u0902\u091F\u094D\u0930\u094B\u0932\u0930 \u0921\u093E\u0909\u0928\u0932\u094B\u0921
      \u0915\u0930\u0947\u0902\r\n                \u0935\u093F\u091C\u093F\u091F
      \u0915\u0930\u0947\u0902: www.nexboxgames.com/download\r\n                \u092F\u093E
      Play Store / App Store \u092A\u0930 \"nexbox controller\" \u0916\u094B\u091C\u0947\u0902\r\n               
      \u0915\u0947\u0935\u0932 TV \u092A\u0930 Neuplay Ventures LLP / nexbox game
      \u0915\u0947 \u0938\u093E\u0925 \u0938\u0902\u0917\u0924\r\n               
      \u091A\u0930\u0923 2\r\n                \u0938\u094D\u0915\u0948\u0928 \u0914\u0930
      \u0915\u0928\u0947\u0915\u094D\u091F \u0915\u0930\u0947\u0902\r\n               
      \u0938\u0941\u0928\u093F\u0936\u094D\u091A\u093F\u0924 \u0915\u0930\u0947\u0902
      \u0915\u093F TV \u0914\u0930 \u092E\u094B\u092C\u093E\u0907\u0932 \u090F\u0915
      \u0939\u0940 Wi-Fi \u0928\u0947\u091F\u0935\u0930\u094D\u0915 \u092A\u0930
      \u0939\u0948\u0902\r\n                nexbox controller \u0910\u092A \u0916\u094B\u0932\u0947\u0902\r\n               
      \u0915\u0902\u091F\u094D\u0930\u094B\u0932\u0930 \u092A\u0930 \"QR \u0915\u094B\u0921
      \u0938\u094D\u0915\u0948\u0928 \u0915\u0930\u0947\u0902\" \u0926\u092C\u093E\u090F\u0902\r\n               
      \u0907\u0938\u0947 \u0928\u0940\u091A\u0947 \u0926\u093F\u090F \u0917\u090F
      QR \u0915\u094B\u0921 \u092A\u0930 \u092A\u0949\u0907\u0902\u091F \u0915\u0930\u0947\u0902\r\n               
      \u0917\u0947\u092E \u0914\u0930 \u0915\u0902\u091F\u094D\u0930\u094B\u0932\u0930
      \u0905\u0927\u093F\u0915\u0924\u092E 30 \u0938\u0947\u0915\u0902\u0921 \u092E\u0947\u0902
      \u0905\u092A\u0928\u0947 \u0906\u092A \u092A\u0947\u092F\u0930 \u0939\u094B
      \u091C\u093E\u090F\u0902\u0917\u0947"
