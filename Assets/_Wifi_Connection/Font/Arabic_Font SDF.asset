    atlasWidth: 1024
    atlasHeight: 1024
    characterSetSelectionMode: 7
    characterSequence: "\u0627\u0644\u062E\u0637\u0648\u0629 1\r\n              
      \t\t\u0642\u0645 \u0628\u062A\u0646\u0632\u064A\u0644 \u062A\u062D\u0643\u0645
      nexbox \u0639\u0644\u0649 \u0627\u0644\u0647\u0627\u062A\u0641 \u0627\u0644\u0645\u062D\u0645\u0648\u0644\r\n              
      \t\t\u0642\u0645 \u0628\u0632\u064A\u0627\u0631\u0629: www.nexboxgames.com/download\r\n               
      \u0623\u0648 \u0627\u0628\u062D\u062B \u0639\u0646 \"nexbox controller\" \u0641\u064A
      Play Store / App Store\r\n                \u0645\u062A\u0648\u0627\u0641\u0642
      \u0641\u0642\u0637 \u0645\u0639 Neuplay Ventures LLP / nexbox game \u0639\u0644\u0649
      \u0627\u0644\u062A\u0644\u0641\u0632\u064A\u0648\u0646\r\n               \t\t\u0627\u0644\u062E\u0637\u0648\u0629
      2\r\n                \t\u0645\u0633\u062D \u0636\u0648\u0626\u064A \u0648\u0627\u062A\u0635\u0627\u0644\r\n               
      \t\u062A\u0623\u0643\u062F \u0645\u0646 \u0623\u0646 \u0627\u0644\u062A\u0644\u0641\u0632\u064A\u0648\u0646
      \u0648\u0627\u0644\u0647\u0627\u062A\u0641 \u0627\u0644\u0645\u062D\u0645\u0648\u0644
      \u0639\u0644\u0649 \u0646\u0641\u0633 \u0634\u0628\u0643\u0629 Wi-Fi\r\n               
      \u0627\u0641\u062A\u062D \u062A\u0637\u0628\u064A\u0642 nexbox controller\r\n               
      \u0627\u0636\u063A\u0637 \u0639\u0644\u0649 \"\u0645\u0633\u062D \u0631\u0645\u0632
      QR\" \u0641\u064A \u0648\u062D\u062F\u0629 \u0627\u0644\u062A\u062D\u0643\u0645\r\n               
      \t\u0648\u062C\u0647\u0647 \u0625\u0644\u0649 \u0631\u0645\u0632 QR \u0623\u062F\u0646\u0627\u0647\r\n              
      \t \t\u0633\u062A\u0642\u062A\u0631\u0646 \u0627\u0644\u0644\u0639\u0628\u0629
      \u0648\u0648\u062D\u062F\u0629 \u0627\u0644\u062A\u062D\u0643\u0645 \u062A\u0644\u0642\u0627\u0626\u064A\u0627\u064B
      \u0641\u064A \u063A\u0636\u0648\u0646 30 \u062B\u0627\u0646\u064A\u0629 \u0643\u062D\u062F
      \u0623\u0642\u0635\u0649"
