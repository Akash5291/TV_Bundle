    characterSetSelectionMode: 7
    characterSequence: "\u0428\u0430\u0433 1\r\n                \u0421\u043A\u0430\u0447\u0430\u0439\u0442\u0435
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440 nexbox \u043D\u0430
      \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u044B\u0439\r\n                \u041F\u043E\u0441\u0435\u0442\u0438\u0442\u0435:
      www.nexboxgames.com/download\r\n                \u0418\u041B\u0418 \u043D\u0430\u0439\u0434\u0438\u0442\u0435
      \"nexbox controller\" \u0432 Play Store / App Store\r\n                \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441 Neuplay Ventures LLP / nexbox game
      \u043D\u0430 \u0422\u0412\r\n                \u0428\u0430\u0433 2\r\n               
      \u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0438 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F\r\n               
      \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E
      \u0422\u0412 \u0438 \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u044B\u0439
      \u0432 \u043E\u0434\u043D\u043E\u0439 Wi-Fi \u0441\u0435\u0442\u0438\r\n               
      \u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      nexbox controller\r\n                \u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \"\u0421\u043A\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C QR \u043A\u043E\u0434\"
      \u043D\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0435\r\n               
      \u041D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043D\u0430 QR \u043A\u043E\u0434
      \u043D\u0438\u0436\u0435\r\n                \u0418\u0433\u0440\u0430 \u0438
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u0441\u044F \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C 30 \u0441\u0435\u043A\u0443\u043D\u0434"
